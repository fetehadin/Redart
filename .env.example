# ---------- api (apps/api) ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the API (Caddy in production = 1)
TRUST_PROXY=0

# ---------- web (apps/web) ----------
# Where `pnpm dev` forwards /api/* (production: Caddy routes /api/* itself)
API_ORIGIN=http://localhost:4000
# Public address, used for social preview links
APP_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://redart:redart@localhost:5544/redart
# Origin allowed to make state-changing requests (CSRF check)
SESSION_COOKIE_NAME=redart_session
# Comma-separated; these accounts become admins when they sign up
ADMIN_EMAILS=
# Optional. Without SMTP, password reset by email is hidden.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
