# ---------- api (apps/api) ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the API (Caddy in production = 1)
TRUST_PROXY=0

# ---------- web (apps/web) ----------
# Where `pnpm dev` forwards /api/* (production: Caddy routes /api/* itself)
API_ORIGIN=http://localhost:4000
# Public address, used for social preview links
APP_ORIGIN=http://localhost:3000

# Added in phase 2: DATABASE_URL, SESSION_COOKIE_NAME, SMTP_*, ADMIN_EMAILS
