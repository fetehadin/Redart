# Copy to /srv/redart/.env on the server (chmod 600). Never commit the real one.
DOMAIN=redart.example.com

# Use a URL-safe password, e.g. the output of: openssl rand -hex 24
POSTGRES_USER=redart
POSTGRES_PASSWORD=
POSTGRES_DB=redart

# Comma-separated emails that become admins when they sign up (can feature challenges)
ADMIN_EMAILS=

# Optional: without SMTP, password reset by email is hidden
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Redart <no-reply@redart.example.com>

LOG_LEVEL=info
