# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Idle connections to the apps are dropped well before the apps' own 65 s keep-alive ends,
	# so Caddy never sends on a connection the app is closing.
	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				keepalive 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 30s
			}
		}
	}

	log {
		output stdout
		format console
	}
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
